# Required: Anthropic API key, used to generate ICP scoring, personalized DM drafts,
# and interest/warmth analysis from conversation logs.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model to use for AI drafting/scoring. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=claude-sonnet-5

# Port the API server listens on.
PORT=4000

# Shared secret you configure in Calendly's webhook settings (Calendly sends it back
# as a query param on the webhook URL you register, e.g. ?secret=...). Used to reject
# unauthenticated calls to /api/calendly/webhook.
CALENDLY_WEBHOOK_SECRET=change-me

# Path to the SQLite database file.
DB_PATH=./data/outreach.db
