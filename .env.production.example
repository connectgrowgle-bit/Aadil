APP_ENV=production
APP_URL=https://groweazzy.example

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/groweazzy_production
DATABASE_SSL=true

SESSION_SECRET=
PII_ENCRYPTION_KEY=

PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=live
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Separate value from RAZORPAY_KEY_SECRET — a different Razorpay dashboard page.
RAZORPAY_WEBHOOK_SECRET=

CRON_SECRET=

EMAIL_PROVIDER=ses
STORAGE_DRIVER=s3
# Required in production — env validation refuses to boot without it.
SENTRY_DSN=https://xxxx@sentry.io/xxxx

TRUSTED_PROXY_HEADER=x-real-ip
