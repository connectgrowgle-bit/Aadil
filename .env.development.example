# Copy to .env.local for local development.
APP_ENV=development
APP_URL=http://localhost:3000

# No ?schema= parameter — pg_dump rejects it, so it can't be tolerated here either.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/groweazzy_dev
DATABASE_SSL=false

# openssl rand -base64 48
SESSION_SECRET=

# openssl rand -hex 32 — rotating this breaks decryption of existing KYC records.
PII_ENCRYPTION_KEY=

PAYMENT_PROVIDER=mock
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# openssl rand -hex 32
CRON_SECRET=

EMAIL_PROVIDER=console
STORAGE_DRIVER=local
SENTRY_DSN=

TRUSTED_PROXY_HEADER=x-real-ip
