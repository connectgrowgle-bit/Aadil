APP_ENV=staging
APP_URL=https://staging.groweazzy.example

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/groweazzy_staging
DATABASE_SSL=true

SESSION_SECRET=
PII_ENCRYPTION_KEY=

# Use Razorpay TEST mode keys on staging — never live keys.
PAYMENT_PROVIDER=razorpay
PAYMENT_MODE=test
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Separate value from RAZORPAY_KEY_SECRET — a different Razorpay dashboard page.
RAZORPAY_WEBHOOK_SECRET=

CRON_SECRET=

EMAIL_PROVIDER=resend
STORAGE_DRIVER=s3
SENTRY_DSN=https://xxxx@sentry.io/xxxx

TRUSTED_PROXY_HEADER=x-real-ip
